            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('tempo de resposta < ' + pm.collectionVariables.get('max_response_ms') + ' ms', () => pm.expect(pm.response.responseTime).to.be.below(Number(pm.collectionVariables.get('max_response_ms'))));",
              "pm.test('corpo cont\u00e9m size_mb=16', () => pm.expect(pm.response.json().size_mb).to.eql(16));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
