{
  "info": {
    "name": "Memory-bound - teste de carga",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('tempo de resposta < ' + pm.collectionVariables.get('max_response_ms') + ' ms', () => pm.expect(pm.response.responseTime).to.be.below(Number(pm.collectionVariables.get('max_response_ms'))));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
